{
  "name": "gongpil-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "start": "node client/src/client-process.ts",
    "demo:bootstrap": "node client/demo/client-core-loopback-bootstrap-demo.ts",
    "demo:network": "node platform/network-runtime/demo/network-runtime-demo.ts",
    "demo:network:loopback": "node platform/network-runtime/demo/loopback-network-runtime-demo.ts",
    "test:bootstrap": "node --test tests/bootstrap/client-core-loopback-bootstrap.test.ts",
    "test:client": "node --test tests/client/client-connector-settings.test.ts tests/client/persistent-client-lifecycle.test.ts",
    "test:ai": "node --test tests/ai/openai-chat-proposal.test.ts tests/ai/codex-provider-usage.test.ts",
    "test:diagnostics": "node --test tests/diagnostics/developer-log.test.ts",
    "test:chunks": "node --test tests/chunks/chunk-index-search.test.ts",
    "test:context": "node --test tests/context/persona-context-source.test.ts tests/context/chat-history-context.test.ts tests/context/chat-history-ui.test.ts",
    "test:mvp": "node --test tests/mvp/project-document-mvp.test.ts",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1",
    "test:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-portable.ps1",
    "test:network": "node --test platform/network-runtime/test/network-runtime.test.ts platform/network-runtime/test/loopback-network-runtime.test.ts",
    "validate:architecture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-code-map.ps1",
    "validate:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-release.ps1"
  }
}
